{
  "name": "react-memory-leak-detector",
  "version": "1.3.0",
  "description": "Stop hunting memory leaks with heap snapshots. This babel plugin tags every React component and hook with a uniquely-named marker, then a runtime tracker uses WeakRef + FinalizationRegistry to warn you, live in the console, the moment something leaks.",
  "keywords": [
    "react",
    "memory-leak",
    "leak-detection",
    "heap-snapshot",
    "babel-plugin",
    "devtools",
    "weakref",
    "finalizationregistry",
    "debugging"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "npm test && npm run build && npm run typecheck"
  },
  "exports": {
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./babel-plugin": {
      "types": "./babel-plugin.d.ts",
      "default": "./babel-plugin.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "vite.js",
    "vite.d.ts",
    "lib/",
    "babel-plugin.js",
    "babel-plugin.d.ts",
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvladm14/react-memory-leak-detector.git"
  },
  "license": "MIT",
  "author": "mvladm14",
  "optionalDependencies": {
    "magic-string": "^1.1.0",
    "oxc-parser": "^0.143.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vite": ">=4",
    "@babel/core": "^7.23.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@babel/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  }
}

{
  "name": "memleak",
  "version": "1.3.0",
  "private": true,
  "description": "Stop hunting memory leaks with heap snapshots. A Vite plugin tags every React component/hook or Vue <script setup> component with a uniquely-named marker, then a framework-agnostic runtime tracker uses WeakRef + FinalizationRegistry to warn you, live in the console, the moment something leaks. Monorepo: @memleak/core + per-framework adapters.",
  "keywords": [
    "react",
    "vue",
    "memory-leak",
    "leak-detection",
    "heap-snapshot",
    "vite-plugin",
    "babel-plugin",
    "devtools",
    "weakref",
    "finalizationregistry",
    "debugging"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvladm14/memory-leak-detector.git"
  },
  "license": "MIT",
  "author": "mvladm14",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.41",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vue": "^3.5.41"
  }
}
